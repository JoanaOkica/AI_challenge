# Copy this file to `.env.local` (which is gitignored) and set your real key.
#
#   cp .env.local.example .env.local
#   # then edit .env.local
#
# The Case Builder and Court Presentation modules call Google Gemini from
# server-side Next.js routes. Get a key from https://aistudio.google.com/apikey
# Never commit the real key, and never paste it into a chat, issue or ticket.

GOOGLE_API_KEY=your-key-here

# Optional — override if this model is renamed or unavailable on your tier.
# GEMINI_MODEL=gemini-2.5-flash

# Free-tier privacy: Google may use free-tier prompts to improve their products,
# including human review. That is fine for the synthetic sample case this app
# ships with. Enable billing (or move to a provider that does not train on API
# data) before sending a real client chronology through it — medical records and
# attorney work product should not land in a training corpus.
