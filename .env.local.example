# Copy this file to `.env.local` (which is gitignored) and set your real key.
#
#   cp .env.local.example .env.local
#   # then edit .env.local
#
# The Case Builder and Court Presentation modules call Claude from server-side
# Next.js routes. Anthropic API keys come from https://console.anthropic.com
# and start with `sk-ant-`. Never commit the real key.

ANTHROPIC_API_KEY=sk-ant-...
