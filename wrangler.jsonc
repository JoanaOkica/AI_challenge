{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chronology-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  // The Gemini SDK and Next's server runtime expect Node globals; workerd only
  // provides them behind this flag.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
